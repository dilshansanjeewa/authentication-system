<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- JDBC Database Connection Settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/auth_system?createDatabaseIfNotExist=true</property>
        <property name="hibernate.connection.username"><!--user-->></property>
        <property name="hibernate.connection.password"><!--password--></property>

        <!-- Show SQL statements in console -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.use_sql_comments">true</property>
        <property name="hibernate.highlight_sql">true</property>

        <!-- Enable Hibernate to automatically create/drop tables -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Mapping files or annotated classes -->
        <mapping class="model.entity.User"/>

    </session-factory>
</hibernate-configuration>
